# AFCD Foundation (afcdfoundation.com + Studio). Lives in /srv/afcd-website/caddy on the VPS, outside AFCD Connect's
# folder; AFCD Connect's Caddyfile only has:  import /etc/caddy/sites/*.caddy
# The website files are mounted read-only at /srv/afcd-website; Studio is reached on the "afcd-edge" network.

(afcd_security) {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

afcdfoundation.com {
	import afcd_security
	root * /srv/afcd-website
	encode zstd gzip
	# Category/page addresses (lib/urls.mjs): /projects/x, /pillars/x, /about/team, no ".html", also under /fr and /ar.
	# 1. Old addresses (project-x.html, team.html, …, with or without .html) move permanently (301) to the new ones.
	map {path} {afcd_new} {
		~^/(fr/|ar/)?project-([a-z0-9-]+)(?:\.html)?$ "/${1}projects/${2}"
		~^/(fr/|ar/)?news-([a-z0-9-]+)(?:\.html)?$ "/${1}news/${2}"
		~^/(fr/|ar/)?event-([a-z0-9-]+)(?:\.html)?$ "/${1}events/${2}"
		~^/(fr/|ar/)?publication-([a-z0-9-]+)(?:\.html)?$ "/${1}publications/${2}"
		~^/(fr/|ar/)?opportunity-([a-z0-9-]+)(?:\.html)?$ "/${1}opportunities/${2}"
		~^/(fr/|ar/)?(our-story|mission-vision|strategy|team)(?:\.html)?$ "/${1}about/${2}"
		~^/(fr/|ar/)?(youth-empowerment|womens-empowerment|environment-climate|digital-inclusion)(?:\.html)?$ "/${1}pillars/${2}"
		~^/(fr/|ar/)?index\.html$ "/${1}"
		~^/(fr/|ar/)?((?:projects|news|events|publications|opportunities|about|pillars|partners|contact|get-involved)(?:/[a-z0-9-]+)?)/$ "/${1}${2}"
		~^/(.+)\.html$ "/${1}"
		default ""
	}
	@afcd_old expression {afcd_new} != ""
	redir @afcd_old {afcd_new}{?query} 301
	# 2. New addresses are served from the page files, which keep their names on disk.
	map {path} {afcd_file} {
		~^/(fr/|ar/)?projects/([a-z0-9-]+)$ "/${1}project-${2}.html"
		~^/(fr/|ar/)?news/([a-z0-9-]+)$ "/${1}news-${2}.html"
		~^/(fr/|ar/)?events/([a-z0-9-]+)$ "/${1}event-${2}.html"
		~^/(fr/|ar/)?publications/([a-z0-9-]+)$ "/${1}publication-${2}.html"
		~^/(fr/|ar/)?opportunities/([a-z0-9-]+)$ "/${1}opportunity-${2}.html"
		~^/(fr/|ar/)?(?:about|pillars)/([a-z0-9-]+)$ "/${1}${2}.html"
		default ""
	}
	@afcd_page expression {afcd_file} != ""
	rewrite @afcd_page {afcd_file}
	try_files {path} {path}.html {path}/index.html
	file_server
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}

www.afcdfoundation.com {
	redir https://afcdfoundation.com{uri} permanent
}

studio.afcdfoundation.com {
	import afcd_security
	encode zstd gzip
	redir / /studio/ 302
	request_body {
		max_size 60MB
	}
	reverse_proxy studio-app:4400 {
		header_up X-Forwarded-Proto https
	}
}
