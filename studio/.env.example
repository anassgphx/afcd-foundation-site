# AFCD Studio environment. Copy to .env and fill in. Never commit .env.
PORT=4400
# Public origin of the Studio (cookies + CSRF origin check). Use https:// in production.
STUDIO_ORIGIN=http://localhost:4400
# Production: a PostgreSQL connection string. If empty, an embedded PGlite database is used in STUDIO_DATA_DIR.
DATABASE_URL=
# Where Studio keeps its local database, uploaded originals and image derivatives.
STUDIO_DATA_DIR=.data
# Folder of the public website (contains build.mjs and src/). Defaults to the parent folder.
SITE_ROOT=..
# Max upload size in megabytes.
MAX_UPLOAD_MB=15
# Public website URL (for 'View website' links)
PUBLIC_SITE_URL=http://localhost:4321/

# Google Search Console (SEO Pro). Create an OAuth client (type: Web application) in AFCD's Google Cloud project,
# enable the "Google Search Console API", and register this exact redirect URI:
#   http://localhost:4400/studio/api/seo/google/callback   (or your Studio origin + the same path)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to STUDIO_ORIGIN + /studio/api/seo/google/callback
GOOGLE_REDIRECT_URI=
# Encrypts stored Google tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and stable: changing it means reconnecting Google.
STUDIO_ENCRYPTION_KEY=
