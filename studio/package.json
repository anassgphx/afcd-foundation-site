{
  "name": "afcd-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AFCD Studio: custom CMS for the AFCD Foundation website",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build:admin": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/cli/migrate.ts",
    "db:seed": "tsx src/server/cli/seed.ts",
    "user:create": "tsx src/server/cli/create-user.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "user:password": "tsx src/server/cli/set-password.ts",
    "content:reset": "tsx src/server/cli/reset-content.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@hono/node-server": "^2.1.11",
    "@node-rs/argon2": "^2.2.2",
    "@tiptap/core": "2.27.3",
    "@tiptap/extension-character-count": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
